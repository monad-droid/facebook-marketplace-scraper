# Facebook Marketplace location (city/state or coordinates)
FB_LOCATION=new york
FB_RADIUS_MILES=30
FB_MAX_PRICE=1000

# eBay settings
EBAY_SOLD_DAYS=7

# Profit requirements
MIN_PROFIT_PERCENT=100
ESTIMATED_SHIPPING_COST=15.00

# Browser settings
HEADLESS=true

# Residential proxy (required for VPS/datacenter servers)
# Facebook blocks Marketplace from datacenter IPs — you need a residential proxy.
# Format: http://user:pass@host:port or socks5://user:pass@host:port
# Providers: Bright Data, Oxylabs, IPRoyal, SmartProxy, etc.
PROXY_URL=

# eBay Listing Tracker (ebay_tracker.py)
# Get a bot token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
# Your Telegram chat ID (send /start to the bot to find it)
TELEGRAM_CHAT_ID=
# How often to check for new listings (seconds, default 300 = 5 min)
EBAY_CHECK_INTERVAL=300
